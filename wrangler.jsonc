{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repositoriovamisa10",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-03",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "camisa10-catalogo",
      "database_id": "0aedf94a-2c7a-4eba-9060-89e8fa97019a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CATALOG_MEDIA",
      "bucket_name": "catalogo"
    }
  ],
  "assets": {
    "directory": "dist/assets",
    "binding": "ASSETS"
  },
  "account_id": "d713c51f91c9b68f183a3656bf7d5aa4"
}
