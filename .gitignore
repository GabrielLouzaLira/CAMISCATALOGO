# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.devserver.*.log

# env files (can opt-in for committing if needed)
.env*

# Configurações locais e dados de desenvolvimento. O arquivo de exemplo pode ir ao Git.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Registros e instruções locais do Codex não fazem parte da aplicação publicada.
/.codex/
/docs/agent-workflow/runs/

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
**/.wrangler/
/outputs/
/work/

# Tipos gerados pelo Wrangler a partir da configuração local.
/worker-configuration.d.ts
